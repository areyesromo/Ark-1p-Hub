{
  "name": "ark-1p-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Solo arcade games for the living room: the TV is the screen, your phone is the controller.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "desktop": "electron desktop/main.js",
    "dist:linux": "electron-builder --config desktop/electron-builder.yml --linux",
    "dist:win": "electron-builder --config desktop/electron-builder.yml --win"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "word-list": "^4.1.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "37.10.3",
    "electron-builder": "26.15.3",
    "socket.io-client": "^4.8.4"
  },
  "optionalDependencies": {
    "electron-updater": "6.8.9"
  },
  "author": "Ark 1P Hub"
}
